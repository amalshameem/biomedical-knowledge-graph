# ==========================================
# BioKG Environment Configuration Template
# Copy this file to .env and fill in values
# ==========================================

# ── Relational Database (SQLite by default, or PostgreSQL)
# SQLite default:
DATABASE_URL=sqlite:///./biomed.db
# PostgreSQL example (e.g. for Docker):
# DATABASE_URL=postgresql://biomed:biomed_password@localhost:5432/biomed_kg

# ── Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── LLM Providers & API Keys (Optional - Can also be set in the Web UI Settings)
# OpenRouter (Multi-provider gateway)
OPENROUTER_API_KEY=

# Ollama Cloud (For https://ollama.com/v1 inference)
OLLAMA_API_KEY=

# Google Gemini (From https://aistudio.google.com)
GEMINI_API_KEY=

# Groq (Ultra-fast inference from https://console.groq.com)
GROQ_API_KEY=

# Anthropic (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Mistral AI (Codestral, Mistral Large)
MISTRAL_API_KEY=

# ── NCBI Entrez PubMed Integration (Rate limiting & automated citation enrichment)
ENTREZ_EMAIL=your_email@domain.com
ENTREZ_API_KEY=


## Note: This file is not necessary to have as the app already has seperate settings to add API keys
